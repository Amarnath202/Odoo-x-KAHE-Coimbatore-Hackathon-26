# ===========================================
# SHIV FURNITURE WORKS - ERP ENVIRONMENT
# ===========================================

# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/shiv_furniture_erp"

# Server
PORT=5000
NODE_ENV=development

# JWT Access Token (short-lived)
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_min_32_chars
JWT_EXPIRES_IN=15m

# Refresh Token (long-lived, stored in HttpOnly cookie)
REFRESH_SECRET=your_super_secret_refresh_key_change_this_in_production_min_32_chars
REFRESH_EXPIRES_IN=7d

# Logging
LOG_LEVEL=info
